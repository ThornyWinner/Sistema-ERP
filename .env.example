# Plantilla de variables de entorno.
# Copia este archivo como .env y llena los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API). El archivo .env no se sube al repositorio.

# URL del proyecto, p. ej. https://<id-del-proyecto>.supabase.co
VITE_SUPABASE_URL=

# Llave pública (publishable / anon). Nunca uses aquí la llave service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=
